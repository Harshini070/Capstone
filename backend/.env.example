PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/grievancehub
NLP_SERVICE_URL=http://127.0.0.1:8000

# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173

# Reviewer keys for status/category updates: name:key pairs, comma-separated.
# Keys must be at least 16 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# If empty, updates are unauthenticated in development and disabled in production.
REVIEWER_API_KEYS=
